PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/ai_scholarship_matcher
JWT_SECRET=your_jwt_secret_key_here
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:5000

# Optional AI Provider Configuration (defaults to intelligent rule-based engine if empty)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Email Configuration (Required for verification & password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
EMAIL_FROM="AI Scholarship Matcher <noreply@scholarshipmatcher.edu>"

# Admin Security & One-Time Bootstrap Configuration
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_SECRET=your_strong_admin_bootstrap_secret_here
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# Optional comma-separated list of allowed admin emails
# ADMIN_ALLOWED_EMAILS=admin@example.com